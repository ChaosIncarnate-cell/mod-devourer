[worldserver]

########################################
# mod-devourer: the Devourer (class 10)
########################################

#    Devourer.Enable
#        Description: Turns the module on or off. Off, it does nothing at all: no shapes, devouring,
#                     shifting, spec abilities or warrior-like stats, and its tables are not read.
#        Default:     1

Devourer.Enable = 1

#    Devourer.ClassId
#        Description: The class id the Devourer lives in (CLASS_DEVOURER in core-patch/).
#        Default:     10

Devourer.ClassId = 10

#    Devourer.RequireLooted
#        Description: Only corpses the Devourer (or its group) has the right to loot can be devoured.
#        Default:     1

Devourer.RequireLooted = 1

#    Devourer.HungerPerMeal
#        Description: Anima gained by devouring a corpse (the rage bar, 0-100; Anima was called Hunger).
#        Default:     30

Devourer.HungerPerMeal = 30

#    Devourer.AnimaPerShift
#        Description: Anima a shift into a shape costs (0 = free). Concentrate gives 30, a meal 30.
#        Default:     25

Devourer.AnimaPerShift = 25

#    Devourer.HungerPerSwing
#        Description: Anima gained by each of the Devourer's own auto-attack hits. 0 = off.
#        Default:     2

Devourer.HungerPerSwing = 2

#    Devourer.ShiftCooldown / Devourer.SkinchangerShiftCooldown
#        Description: The one cooldown all shapes share, in milliseconds. The form spells carry the normal
#                     value; a Skinchanger's recovers faster. (Changing ShiftCooldown also needs the spells
#                     rebuilt with tools/build_devourer_spells.py.)
#        Default:     8000 / 3000

Devourer.ShiftCooldown = 8000
Devourer.SkinchangerShiftCooldown = 3000

#    Devourer.ShapeBarSlot
#        Description: First action button the worn shape's four abilities are placed on (60 = the start of
#                     the bottom-left bar). 0 leaves the action bars alone.
#        Default:     60

Devourer.ShapeBarSlot = 60

#    Devourer.InBetween.Enable
#        Description: The Hollowmoor witch sisters' ritual (task 010): at Devourer.InBetween.Level a Devourer is
#                     pulled into the In-Between, wakes caged, becomes a Baby Berserker and does the sisters'
#                     chores; then they are its trainers. 0 = no ritual, no cage, no .inbetween (the sisters
#                     still stand there and train a Devourer that has done the chores).
#        Default:     1

Devourer.InBetween.Enable = 1

#    Devourer.InBetween.Level
#        Description: The level at which the ritual takes the Devourer (also at login, if it is at this level or
#                     higher and has not done the chores).
#        Default:     5

Devourer.InBetween.Level = 5

#    Devourer.InBetween.ReturnCooldown
#        Description: Seconds between two uses of .inbetween (a freed Devourer goes back to the sisters).
#        Default:     1800

Devourer.InBetween.ReturnCooldown = 1800
